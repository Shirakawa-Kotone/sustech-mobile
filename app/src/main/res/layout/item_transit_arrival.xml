<?xml version="1.0" encoding="utf-8"?>
<!--
  One bus about to reach the open stop — a departure-board tile, not a sentence.

  [● Line 1]                       4 min
  Clockwise → Research Bldg 3
  ●●●●●●●●●○○○○○  790 m away
  live
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardBase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/transit_line_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/transit_line_dot" />

            <TextView
                android:id="@+id/transit_line_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Line 1" />

            <TextView
                android:id="@+id/transit_eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="4 min" />
        </LinearLayout>

        <TextView
            android:id="@+id/transit_direction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="13sp"
            tools:text="Clockwise → Research Bldg 3" />

        <TextView
            android:id="@+id/transit_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink"
            android:textSize="12sp"
            tools:text="8 stops away · next 学生宿舍北" />

        <ProgressBar
            android:id="@+id/transit_approach"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/transit_approach_bar"
            tools:progress="70" />

        <TextView
            android:id="@+id/transit_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink_muted"
            android:textSize="12sp"
            tools:text="790 m away · live" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
