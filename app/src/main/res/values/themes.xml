<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light-only on purpose: every color in this app is a fixed light palette, so a
         DayNight parent would mix dark-mode tints (near-white) with those white
         surfaces and render the bottom bar invisible until an item was selected. -->
    <style name="Theme.SustechMobile" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/brand_dark</item>
    </style>

    <style name="CardBase" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="FieldValue">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
