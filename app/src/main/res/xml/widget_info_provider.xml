<?xml version="1.0" encoding="utf-8"?>
<!--
  30 minutes is the platform's floor for updatePeriodMillis; the real refresh
  cadence (tap + 60s alarm while the screen is on) is driven by
  InfoWidgetProvider. This value only covers reboot/system nudges.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_info"
    android:configure="edu.sustech.mobile.widget.WidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
